{
  "title": "HRMS Shards & Redis",
  "uid": "shards-redis",
  "tags": ["hrms", "shards", "redis"],
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "Active PG connections",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count)",
          "format": "time_series",
          "interval": ""
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "stat",
      "title": "Redis memory used (bytes)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(redis_memory_used_bytes)",
          "format": "time_series",
          "interval": ""
        }
      ],
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "stat",
      "title": "429 rejects by scope",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(rate_limit_rejected_total{scope=~\"login|accept|search|crawl|jobs|suggest\"}[5m])) or vector(0)",
          "format": "time_series",
          "interval": ""
        }
      ],
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 4}
    }
  ],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s"
}
