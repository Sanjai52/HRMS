{
  "title": "HRMS API Overview",
  "uid": "api-overview",
  "tags": ["hrms", "api", "overview"],
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "HTTP requests total",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(hrms_http_requests_total)",
          "format": "time_series",
          "interval": ""
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "stat",
      "title": "HTTP request p95 duration (s)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hrms_http_request_seconds_bucket[5m])))",
          "format": "stat",
          "interval": ""
        }
      ],
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "stat",
      "title": "HTTP 5xx total",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(hrms_http_requests_total{status=~\"5..\"}[5m])) or vector(0)",
          "format": "time_series",
          "interval": ""
        }
      ],
      "gridPos": {"x": 0, "y": 4, "w": 6, "h": 4}
    },
    {
      "type": "stat",
      "title": "HTTP average latency (ms)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "(sum(rate(hrms_http_request_seconds_sum[5m])) / sum(rate(hrms_http_request_seconds_count[5m]))) * 1000",
          "format": "time_series",
          "interval": ""
        }
      ],
      "gridPos": {"x": 6, "y": 4, "w": 6, "h": 4}
    }
  ],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s"
}
