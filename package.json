{
  "name": "hrms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:pool-access": "bash scripts/check-direct-pool-access.sh",
    "check:shard-tables": "node scripts/check-shard-owned-tables.mjs",
    "ci": "npm run typecheck && npm run lint && npm run check:pool-access && npm run check:shard-tables && npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
